#!/bin/sh

# Ensure the system group exists
if ! getent group tengine >/dev/null 2>&1; then
	addgroup -S tengine 2>/dev/null
fi

# Ensure the system user exists
if ! getent passwd tengine >/dev/null 2>&1; then
	adduser -S -D -H \
		-h /var/cache/tengine \
		-s /sbin/nologin \
		-G tengine \
		-g "Tengine web server" \
		tengine 2>/dev/null
fi

exit 0
