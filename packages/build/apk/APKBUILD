# Contributor: Tengine Team <tengine@taobao.net>
# Maintainer: Tengine Team <tengine@taobao.net>
pkgname=tengine
_upstream_ver=3.2.0
pkgver=3.2.0
pkgrel=0
pkgdesc="Tengine HTTP and reverse proxy server with Tongsuo, xquic and Lua"
url="https://tengine.taobao.org/"
arch="all"
license="BSD-2-Clause AND Apache-2.0 AND MIT"
depends="logrotate"
makedepends="
	cmake
	g++
	linux-headers
	openssl-dev
	pcre2-dev
	perl
	zlib-dev
	"
install="$pkgname.pre-install"
subpackages="$pkgname-doc $pkgname-openrc"
source="
	$pkgname-$_upstream_ver.tar.gz
	$pkgname-deps.tar.gz
	tengine.openrc
	tengine.logrotate
	tengine.conf
	default.conf
	"
builddir="$srcdir/$pkgname-$_upstream_ver"
options="!check" # No upstream test suite wired into the build

build() {
	export TENGINE_LIBDIR=/usr/lib
	export TENGINE_WITH_BACKTRACE=no

	# Build pinned dependencies
	sh packages/build/build-deps.sh \
		--srcdir "$srcdir/deps" \
		--workdir "$srcdir/deps-build" \
		--staging "$srcdir/deps-staging" \
		--libdir /usr/lib/tengine \
		--datadir /usr/share/tengine

	. "$srcdir"/deps-build/deps-env.sh

	# Extract repeating configuration evaluation arguments
	local cfg_args
	cfg_args=$(sh packages/build/configure-args.sh)

	./configure \
		$cfg_args \
		--with-cc-opt="$CFLAGS -Wno-error" \
		--with-ld-opt="$LDFLAGS $(sh packages/build/configure-args.sh --print-ld-opt)" \
		--with-openssl-opt="$(sh packages/build/configure-args.sh --print-openssl-opt)"

	make
}

package() {
	make DESTDIR="$pkgdir" install

	# Merge pre-staged dependencies
	cp -a "$srcdir"/deps-staging/. "$pkgdir"/

	# Remove stock templates and install customized production configs
	rm -f "$pkgdir"/etc/tengine/*.default
	
	install -D -m 0644 "$srcdir"/tengine.conf "$pkgdir"/etc/tengine/tengine.conf
	install -D -m 0644 "$srcdir"/default.conf "$pkgdir"/etc/tengine/conf.d/default.conf
	install -D -m 0644 "$srcdir"/tengine.logrotate "$pkgdir"/etc/logrotate.d/tengine
	install -D -m 0755 "$srcdir"/tengine.openrc "$pkgdir"/etc/init.d/tengine

	# Replace libdir placeholder in config
	sed -i 's|@TENGINE_LIBDIR@|/usr/lib|g' "$pkgdir"/etc/tengine/tengine.conf

	# Generate and place the man page
	sed \
		-e 's|%%PREFIX%%|/usr/share/tengine|' \
		-e 's|%%PID_PATH%%|/run/tengine.pid|' \
		-e 's|%%CONF_PATH%%|/etc/tengine/tengine.conf|' \
		-e 's|%%ERROR_LOG_PATH%%|/var/log/tengine/error.log|' \
		man/nginx.8 > tengine.8
	install -D -m 0644 tengine.8 "$pkgdir"/usr/share/man/man8/tengine.8

	# Establish required operational directory structures
	install -d -m 0700 -o tengine -g tengine "$pkgdir"/var/cache/tengine
	install -d -m 0755 -o tengine -g tengine "$pkgdir"/var/log/tengine
	install -d -m 0755 "$pkgdir"/usr/lib/tengine/modules

	# Cleanup transient runtime paths generated by 'make install'
	rm -rf "$pkgdir"/run "$pkgdir"/var/run

	# Licensing compliance
	install -D -m 0644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="SKIP"
