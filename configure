#!/bin/sh

# Copyright (C) Igor Sysoev
# Copyright (C) Nginx, Inc.

# Fail instantly if any command fails or if an uninitialized variable is used
set -eu

# Enforce a predictable, byte-stable C locale for string processing
LC_ALL=C
export LC_ALL

# Load core modules
. auto/options
. auto/init
. auto/sources

# Safe directory generation
[ -d "$NGX_OBJS" ] || mkdir -p "$NGX_OBJS"

# Truncate build files cleanly using POSIX null command
: > "$NGX_AUTO_HEADERS_H"
: > "$NGX_AUTOCONF_ERR"

echo "#define NGX_CONFIGURE \"$NGX_CONFIGURE\"" > "$NGX_AUTO_CONFIG_H"

if [ "${NGX_DEBUG:-NO}" = "YES" ]; then
    have=NGX_DEBUG . auto/have
fi

# Determine target Platform Operating System
if [ -z "${NGX_PLATFORM:-}" ]; then
    echo "checking for OS"

    NGX_SYSTEM=$(uname -s 2>/dev/null || echo "Unknown")
    NGX_RELEASE=$(uname -r 2>/dev/null || echo "Unknown")
    NGX_MACHINE=$(uname -m 2>/dev/null || echo "Unknown")

    echo " + $NGX_SYSTEM $NGX_RELEASE $NGX_MACHINE"
    NGX_PLATFORM="$NGX_SYSTEM:$NGX_RELEASE:$NGX_MACHINE"

    case "$NGX_SYSTEM" in
        MINGW32_* | MINGW64_* | MSYS_*)
            NGX_PLATFORM=win32
            ;;
    esac
else
    echo "building for $NGX_PLATFORM"
    NGX_SYSTEM=$NGX_PLATFORM
fi

. auto/cc/conf

# Non-Windows configurations
if [ "$NGX_PLATFORM" != "win32" ]; then
    . auto/headers
fi

. auto/os/conf

if [ "$NGX_PLATFORM" != "win32" ]; then
    . auto/unix
fi

. auto/threads
. auto/modules
. auto/lib/conf

# Handle Prefix Definitions cleanly
case ".${NGX_PREFIX:-}" in
    .)
        NGX_PREFIX=${NGX_PREFIX:-/usr/local/nginx}
        have=NGX_PREFIX value="\"$NGX_PREFIX/\"" . auto/define
        ;;
    .!)
        NGX_PREFIX=
        ;;
    *)
        have=NGX_PREFIX value="\"$NGX_PREFIX/\"" . auto/define
        ;;
esac

if [ -n "${NGX_CONF_PREFIX:-}" ]; then
    have=NGX_CONF_PREFIX value="\"$NGX_CONF_PREFIX/\"" . auto/define
fi

# DRY (Don't Repeat Yourself) optimization for global filesystem paths
for path in SBIN_PATH CONF_PATH PID_PATH LOCK_PATH ERROR_LOG_PATH HTTP_LOG_PATH; do
    eval "val=\${NGX_$path:-}"
    [ -n "$val" ] && have="NGX_$path" value="\"$val\"" . auto/define
done

# DRY optimization for HTTP temporary directory paths
for tmp in CLIENT PROXY FASTCGI UWSGI SCGI; do
    eval "val=\${NGX_HTTP_${tmp}_TEMP_PATH:-}"
    [ -n "$val" ] && have="NGX_HTTP_${tmp}_TEMP_PATH" value="\"$val\"" . auto/define
done

. auto/make
. auto/lib/make
. auto/install
. auto/stubs

have=NGX_USER value="\"${NGX_USER:-nginx}\"" . auto/define
have=NGX_GROUP value="\"${NGX_GROUP:-nginx}\"" . auto/define

if [ -n "${NGX_BUILD:-}" ]; then
    have=NGX_BUILD value="\"$NGX_BUILD\"" . auto/define
fi

. auto/summary
